        0,
        300
      ],
      "webhookId": "scaffold-invoice-chase-unsub",
      "notes": "Optional signed unsubscribe. Require header X-Chase-Secret. Never commit the real secret."
    },
    {
      "parameters": {
        "jsCode": "// Shared-secret gate: header X-Chase-Secret must match env/placeholder.\n// Set CHASE_UNSUBSCRIBE_SECRET in n8n env (or replace PLACEHOLDER below in a private fork \u2014 never commit real secret).\nconst EXPECTED = String($env.CHASE_UNSUBSCRIBE_SECRET || 'REPLACE_WITH_CHASE_UNSUBSCRIBE_SECRET').trim();\n\nconst item = $input.first().json;\nconst headers = item.headers || {};\n// Header names may be lower-cased by n8n/proxies\nconst got = String(\n  headers['x-chase-secret'] ||\n  headers['X-Chase-Secret'] ||\n  headers['X-CHASE-SECRET'] ||\n  ''\n).trim();\n\nconst body = item.body || item;\nconst invoiceId = String(\n  (body && body.invoiceId) ||\n  (body && body.InvoiceID) ||\n  item.invoiceId ||\n  ''\n).trim();\n\nconst authorized = Boolean(EXPECTED) &&\n  EXPECTED !== 'REPLACE_WITH_CHASE_UNSUBSCRIBE_SECRET' &&\n  got.length > 0 &&\n  got === EXPECTED;\n\nif (!authorized) {\n  return [{\n    json: {\n      ok: false,\n      httpStatus: 401,\n      error: 'unauthorized',\n      InvoiceID: '',\n    }\n  }];\n}\n\nif (!invoiceId) {\n  return [{\n    json: {\n      ok: false,\n      httpStatus: 400,\n      error: 'missing_invoiceId',\n      InvoiceID: '',\n    }\n  }];\n}\n\nconst stamp = new Date().toISOString();\nreturn [{\n  json: {\n    ok: true,\n    httpStatus: 200,\n    InvoiceID: invoiceId,\n    Status: 'Paused',\n    noteAppend: `[${stamp}] STOP received via unsubscribe webhook`,\n  }\n}];\n"
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Check X-Chase-Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000003",
