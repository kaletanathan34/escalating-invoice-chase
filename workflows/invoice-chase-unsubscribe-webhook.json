      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Lookup Invoice",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        780,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PLACEHOLDER_SHEETS_CRED_ID",
          "name": "Google Sheets account"
        }
      },
      "notes": "If lookup options differ in your n8n version, filter rows in the next Code node instead."
    },
    {
      "parameters": {
        "jsCode": "// Append note and force Status=Paused for matching InvoiceID.\nconst auth = $('Check X-Chase-Secret').first().json;\nconst wantId = String(auth.InvoiceID || '').trim().toLowerCase();\nconst noteAppend = auth.noteAppend;\n\nconst out = [];\nfor (const item of items) {\n  const row = item.json;\n  const id = String(row.InvoiceID || '').trim();\n  if (id.toLowerCase() !== wantId) continue;\n  const prevNotes = String(row.Notes || '').trim();\n  const notes = prevNotes ? `${prevNotes} | ${noteAppend}` : noteAppend;\n  out.push({\n    json: {\n      InvoiceID: id,\n      Status: 'Paused',\n      Notes: notes,\n    }\n  });\n}\n\nif (out.length === 0) {\n  return [{\n    json: {\n      InvoiceID: auth.InvoiceID,\n      Status: 'Paused',\n      Notes: noteAppend,\n      _notFound: true,\n    }\n  }];\n}\nreturn out;\n"
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Build Pause Update",
